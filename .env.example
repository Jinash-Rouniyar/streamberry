# TMDB API Read Access Token (v4 auth - a long JWT-like string).
# Get one free at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=tmdb_v4_read_access_token_here

# Playback backends
# Cinejoy uses https://api.wing.st with crush.wasm + POST /g (sealed).
# StreamBerry now speaks that protocol by default — no URL template needed.
WING_API_BASE=https://api.wing.st
# WING_SUBS_BASE=https://subs.wing.st

# Optional extras (only if Wing fails):
# TMDB_EMBED_API_URL=http://localhost:3001
# CONSUMET_API_URL=http://localhost:3000
# CONSUMET_PROVIDER=flixhq
# FLIXHQ_BASE_URL=
# SFLIX_BASE_URL=
# GOKU_BASE_URL=
# HIMOVIES_BASE_URL=
# EXTRACTOR_TIMEOUT_MS=8000

# Cloudflare Worker CORS proxy (required for custom player in browser)
NEXT_PUBLIC_STREAM_PROXY_URL=http://localhost:8787

# Iframe fallback when all backends fail
NEXT_PUBLIC_EMBED_BASE_URL=https://vidsrc.to/embed
